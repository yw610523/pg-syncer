{
  "name": "pg-syncer",
  "version": "0.1.0",
  "description": "基于 pg_dump / pg_restore 的 PostgreSQL 跨环境同步与快照管理 TUI 工具",
  "license": "MIT",
  "keywords": [
    "postgresql",
    "pg_dump",
    "pg_restore",
    "tui",
    "ink",
    "database",
    "sync"
  ],
  "type": "module",
  "bin": {
    "pg-syncer": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "tsx": "^4.23.11",
    "typescript": "^5.9.0"
  }
}
